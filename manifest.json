{
  "manifest_version": 2,
  "name": "ContainerCookies",
  "version": "1.0.0",
  "description": "View, copy and delete cookies per Firefox container. Browse cookies grouped by domain, copy individual cookies or entire domains (Cookie header format), and clear containers. GitHub: https://github.com/soko1/ContainerCookies",
  "author": "soko1",
  "homepage_url": "https://github.com/soko1/ContainerCookies",
  "browser_specific_settings": {
    "gecko": {
      "id": "containercookies@soko1",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": [
    "cookies",
    "browsingData",
    "contextualIdentities",
    "<all_urls>"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon-48.png"
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  }
}
